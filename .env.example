# Copy this file to .env for local overrides. Never commit real secrets.

# PostgreSQL
POSTGRES_DB=aqress_pulse
POSTGRES_USER=aqress_pulse
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5433

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Idempotent local admin seed
AQRESS_PULSE_ADMIN_EMAIL=admin@aqress.dev
AQRESS_PULSE_ADMIN_PASSWORD=replace-with-a-strong-local-password
AQRESS_PULSE_ADMIN_FIRST_NAME=Local
AQRESS_PULSE_ADMIN_LAST_NAME=Administrator

# MQTT / EMQX
MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=change-me-for-local-development
EMQX_NODE_COOKIE=change-me-to-a-long-random-local-cookie
MQTT_PLATFORM_USERNAME=platform:control
MQTT_PLATFORM_PASSWORD=replace-with-a-long-random-platform-password
MQTT_KEEPALIVE_SECONDS=30
DEVICE_OFFLINE_TIMEOUT_SECONDS=90
DEVICE_OFFLINE_CHECK_INTERVAL_SECONDS=10
TELEMETRY_MAX_READINGS_PER_MESSAGE=100
TELEMETRY_MAX_FUTURE_SKEW_SECONDS=300

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional Phase 7 simulator (credentials are provisioned through Device Detail)
SIMULATOR_DEVICE_UID=ESP32-A8C339
SIMULATOR_MQTT_USERNAME=device:ESP32-A8C339
SIMULATOR_MQTT_PASSWORD=paste-one-time-provisioned-password-here
SIMULATOR_HEARTBEAT_INTERVAL_SECONDS=15
SIMULATOR_FIRMWARE_VERSION=0.1.0
SIMULATOR_FORCE_CONFIG_FAILURE=false
SIMULATOR_TELEMETRY_POLL_INTERVAL_SECONDS=0.25
SIMULATOR_RANDOM_SEED=20260822
